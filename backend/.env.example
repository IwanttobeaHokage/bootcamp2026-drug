# ===== 서버 =====
CORS_ORIGINS=http://localhost:5173

# ===== LLM 연결 방식 =====
# mock   : AWS 없이 개발 (기본값). 고정 응답이 나온다.
# http   : API Gateway / Lambda Function URL 을 HTTP 로 호출
# lambda : boto3 로 Lambda 직접 invoke
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30

# ===== [빈 칸] AWS 담당자에게 받아서 채우세요 =====
# --- LLM_PROVIDER=http 일 때 ---
LLM_API_BASE_URL=
LLM_API_PATH=/analyze
LLM_API_KEY=

# --- LLM_PROVIDER=lambda 일 때 ---
AWS_REGION=ap-northeast-2
LAMBDA_FUNCTION_NAME=
# AWS 키는 여기 적지 마세요. `aws configure` 또는 IAM Role 을 사용합니다.
